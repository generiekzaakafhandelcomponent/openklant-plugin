      <bpmndi:BPMNShape id="updatePartij-Identificator_di" bpmnElement="updatePartij-Identificator">
        <dc:Bounds x="1346" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deletePartij-Identificator_di" bpmnElement="deletePartij-Identificator">
        <dc:Bounds x="1526" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deletePartijVoorFixture_di" bpmnElement="deletePartijVoorFixture">
        <dc:Bounds x="1706" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1886" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
