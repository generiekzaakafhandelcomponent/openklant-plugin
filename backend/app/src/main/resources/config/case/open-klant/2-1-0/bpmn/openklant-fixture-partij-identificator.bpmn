<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_openklant-fixture-partij-identificator" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="openklant-fixture-partij-identificator" name="Open Klant fixture: partij-identificatoren" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="createPartijVoorFixture" name="Maak partij aan">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="createPartij-Identificator" name="Maak partijIdentificator aan">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="getPartij-Identificator" name="Haal partijIdentificator op">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showGetPartij-Identificator" name="Toon resultaat: Haal partijIdentificator op">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="listPartij-Identificatoren" name="Haal partijIdentificatoren op">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showListPartij-Identificatoren" name="Toon resultaat: Haal partijIdentificatoren op">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="updatePartij-Identificator" name="Werk partijIdentificator bij">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deletePartij-Identificator" name="Verwijder partijIdentificator">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deletePartijVoorFixture" name="Verwijder partij">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="createPartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="createPartijVoorFixture" targetRef="createPartij-Identificator" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="createPartij-Identificator" targetRef="getPartij-Identificator" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="getPartij-Identificator" targetRef="showGetPartij-Identificator" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="showGetPartij-Identificator" targetRef="listPartij-Identificatoren" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="listPartij-Identificatoren" targetRef="showListPartij-Identificatoren" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="showListPartij-Identificatoren" targetRef="updatePartij-Identificator" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="updatePartij-Identificator" targetRef="deletePartij-Identificator" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="deletePartij-Identificator" targetRef="deletePartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="deletePartijVoorFixture" targetRef="EndEvent_1" />
  </bpmn:process>
