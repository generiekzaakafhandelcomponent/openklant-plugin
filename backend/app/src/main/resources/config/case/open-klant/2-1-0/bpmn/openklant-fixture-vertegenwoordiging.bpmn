    <bpmn:sequenceFlow id="Flow_6" sourceRef="listVertegenwoordigingen" targetRef="showListVertegenwoordigingen" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="showListVertegenwoordigingen" targetRef="updateVertegenwoordiging" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="updateVertegenwoordiging" targetRef="deleteVertegenwoordiging" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="deleteVertegenwoordiging" targetRef="deleteVertegenwoordigdeVoorFixture" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="deleteVertegenwoordigdeVoorFixture" targetRef="deletePartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="deletePartijVoorFixture" targetRef="EndEvent_1" />
