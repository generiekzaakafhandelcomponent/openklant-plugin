      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showListVertegenwoordigingen" name="Toon resultaat: Haal vertegenwoordigingen op">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="updateVertegenwoordiging" name="Werk vertegenwoordiging bij">
