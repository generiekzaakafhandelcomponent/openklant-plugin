      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="createPartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="createPartijVoorFixture" targetRef="createVertegenwoordigdeVoorFixture" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="createVertegenwoordigdeVoorFixture" targetRef="createVertegenwoordiging" />
