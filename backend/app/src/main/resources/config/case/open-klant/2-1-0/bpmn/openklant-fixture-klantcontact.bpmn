  <bpmn:process id="openklant-fixture-klantcontact" name="Open Klant fixture: klantcontacten" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
