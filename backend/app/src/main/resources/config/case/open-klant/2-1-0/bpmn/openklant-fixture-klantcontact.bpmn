    <bpmn:sequenceFlow id="Flow_5" sourceRef="showSearchKlantcontacten" targetRef="updateKlantcontact" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="updateKlantcontact" targetRef="deleteKlantcontact" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="deleteKlantcontact" targetRef="EndEvent_1" />
