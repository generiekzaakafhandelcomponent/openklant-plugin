<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_openklant-fixture-partij" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="openklant-fixture-partij" name="Open Klant fixture: partijen" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="createPartij" name="Maak partij aan">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="getPartij" name="Haal partij op">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showGetPartij" name="Toon resultaat: Haal partij op">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="listPartijen" name="Haal partijen op">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showListPartijen" name="Toon resultaat: Haal partijen op">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="updatePartij" name="Werk partij bij">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deletePartij" name="Verwijder partij">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="createPartij" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="createPartij" targetRef="getPartij" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="getPartij" targetRef="showGetPartij" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="showGetPartij" targetRef="listPartijen" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="listPartijen" targetRef="showListPartijen" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="showListPartijen" targetRef="updatePartij" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="updatePartij" targetRef="deletePartij" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="deletePartij" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_openklant-fixture-partij">
    <bpmndi:BPMNPlane id="BPMNPlane_openklant-fixture-partij" bpmnElement="openklant-fixture-partij">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createPartij_di" bpmnElement="createPartij">
        <dc:Bounds x="266" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="getPartij_di" bpmnElement="getPartij">
        <dc:Bounds x="446" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showGetPartij_di" bpmnElement="showGetPartij">
        <dc:Bounds x="626" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="listPartijen_di" bpmnElement="listPartijen">
        <dc:Bounds x="806" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="showListPartijen_di" bpmnElement="showListPartijen">
        <dc:Bounds x="986" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="updatePartij_di" bpmnElement="updatePartij">
        <dc:Bounds x="1166" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deletePartij_di" bpmnElement="deletePartij">
        <dc:Bounds x="1346" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1526" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="266" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="396" y="130" />
        <di:waypoint x="446" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="576" y="130" />
        <di:waypoint x="626" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="756" y="130" />
        <di:waypoint x="806" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="936" y="130" />
        <di:waypoint x="986" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1116" y="130" />
        <di:waypoint x="1166" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1296" y="130" />
        <di:waypoint x="1346" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1476" y="130" />
        <di:waypoint x="1526" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
