<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_openklant-fixture-betrokkene" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="openklant-fixture-betrokkene" name="Open Klant fixture: betrokkenen" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="createPartijVoorFixture" name="Maak partij aan">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="createKlantcontactVoorFixture" name="Maak klantcontact aan">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="createBetrokkene" name="Maak betrokkene aan">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="getBetrokkene" name="Haal betrokkene op">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showGetBetrokkene" name="Toon resultaat: Haal betrokkene op">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="listBetrokkenen" name="Haal betrokkenen op">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showListBetrokkenen" name="Toon resultaat: Haal betrokkenen op">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="updateBetrokkene" name="Werk betrokkene bij">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deleteBetrokkene" name="Verwijder betrokkene">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deleteKlantcontactVoorFixture" name="Verwijder klantcontact">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deletePartijVoorFixture" name="Verwijder partij">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="createPartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="createPartijVoorFixture" targetRef="createKlantcontactVoorFixture" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="createKlantcontactVoorFixture" targetRef="createBetrokkene" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="createBetrokkene" targetRef="getBetrokkene" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="getBetrokkene" targetRef="showGetBetrokkene" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="showGetBetrokkene" targetRef="listBetrokkenen" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="listBetrokkenen" targetRef="showListBetrokkenen" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="showListBetrokkenen" targetRef="updateBetrokkene" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="updateBetrokkene" targetRef="deleteBetrokkene" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="deleteBetrokkene" targetRef="deleteKlantcontactVoorFixture" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="deleteKlantcontactVoorFixture" targetRef="deletePartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="deletePartijVoorFixture" targetRef="EndEvent_1" />
  </bpmn:process>
