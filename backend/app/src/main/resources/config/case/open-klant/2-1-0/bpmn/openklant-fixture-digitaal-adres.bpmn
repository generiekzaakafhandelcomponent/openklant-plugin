<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_openklant-fixture-digitaal-adres" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="openklant-fixture-digitaal-adres" name="Open Klant fixture: digitale adressen" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="createPartijVoorFixture" name="Maak partij aan">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="createDigitaalAdres" name="Maak digitaal adres aan">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="getDigitaalAdres" name="Haal digitaal adres op">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showGetDigitaalAdres" name="Toon resultaat: Haal digitaal adres op">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="getDigitaleAdressen" name="Haal digitale adressen op">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="showGetDigitaleAdressen" name="Toon resultaat: Haal digitale adressen op">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="updateDigitaalAdres" name="Werk digitaal adres bij">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deleteDigitaalAdres" name="Verwijder digitaal adres">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deletePartijVoorFixture" name="Verwijder partij">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Einde">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="createPartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="createPartijVoorFixture" targetRef="createDigitaalAdres" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="createDigitaalAdres" targetRef="getDigitaalAdres" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="getDigitaalAdres" targetRef="showGetDigitaalAdres" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="showGetDigitaalAdres" targetRef="getDigitaleAdressen" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="getDigitaleAdressen" targetRef="showGetDigitaleAdressen" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="showGetDigitaleAdressen" targetRef="updateDigitaalAdres" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="updateDigitaalAdres" targetRef="deleteDigitaalAdres" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="deleteDigitaalAdres" targetRef="deletePartijVoorFixture" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="deletePartijVoorFixture" targetRef="EndEvent_1" />
  </bpmn:process>
