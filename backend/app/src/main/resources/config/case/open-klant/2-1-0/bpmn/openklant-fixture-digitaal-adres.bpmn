      <bpmndi:BPMNShape id="updateDigitaalAdres_di" bpmnElement="updateDigitaalAdres">
        <dc:Bounds x="1346" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deleteDigitaalAdres_di" bpmnElement="deleteDigitaalAdres">
        <dc:Bounds x="1526" y="90" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deletePartijVoorFixture_di" bpmnElement="deletePartijVoorFixture">
